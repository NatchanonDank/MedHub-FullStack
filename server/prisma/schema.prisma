generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int         @id @default(autoincrement())
  email     String      @unique
  name      String
  password  String
  createdAt DateTime    @default(now())
  kitItems  MyKitItem[]
}

model Medication {
  id                String      @id
  name              String
  genericName       String
  brandName         String?
  strength          String?
  dosageForm        String?
  category          String
  prescriptionType  String?
  specialTag        String?
  dosageInstruction String?
  appearance        String?
  indications       String[]
  sideEffects       String[]
  warnings          String[]
  interactions      String[]
  pregnancyCategory String?
  imageUrl          String?
  createdAt         DateTime    @default(now())
  kitItems          MyKitItem[]
}

model MyKitItem {
  id           Int        @id @default(autoincrement())
  userId       Int
  medicationId String
  note         String?    @default("")
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@unique([userId, medicationId])
}